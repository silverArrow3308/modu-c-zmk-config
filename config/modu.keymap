#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>
#include "modu-layouts.dtsi"

/ {
    /*
     * -------------------------------------------------------------------------
     * 시스템 콤보 및 Lower 전용 모드 전환 키 안내
     * -------------------------------------------------------------------------
     * [Lower 레이어 전용 모드 전환 키 (엄지 MO 누른 상태)]
     * - 49번 (Row 4 LALT 자리): &to 0 -> Windows 기본 모드 (F키 모드)
     * - 50번 (Row 4 LGUI 자리): &to 3 -> Mac 기본 모드 (F키 모드)
     * - 41번 (Row 3 B 자리)   : 현재 OS 내에서 F키 모드 ↔ 멀티미디어 키 모드 상호 토글
     *
     * [콤보(Combos) 안내]
     * - 시스템 소프트 리셋: 엄지 MO 누른 채 LCTRL(48) + 5 + 6 동시 입력
     * -------------------------------------------------------------------------
     */

    combos {
        compatible = "zmk,combos";

        // [시스템 리셋] 엄지 MO 누른 채: LCTRL(48) + 5 + 6 키 동시 입력 -> 키보드 소프트 재부팅
        reset {
            bindings = <&sys_reset>;
            key-positions = <48 5 6>;
            layers = <1 4 6 8>; // 모든 Lower 레이어에서 작동
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------
            // |ESC | 1  | 2  | 3  | 4  | 5  |   | 6  | 7  | 8  | 9  | 0  |DEL |
            // |TAB | Q  | W  | E  | R  | T  |   | Y  | U  | I  | O  | P  |\   |
            // |CAPS| A  | S  | D  | F  | G  |   | H  | J  | K  | L  | ;  |RET |
            // |LSFT| Z  | X  | C  | V  | B  |   | N  | M  | ,  | .  | /  |RSFT|
            // |LCTL|LALT|LGUI|                                 |LANG|RCTRL|INS |
            //                |BSPC|SPC |MO1 |   |MO1 |SPC |BSPC| B  |

            bindings = <
&kp ESC    &kp N1     &kp N2    &kp N3  &kp N4  &kp N5  &kp N6    &kp N7   &kp N8     &kp N9    &kp N0     &kp DELETE
&kp TAB    &kp Q      &kp W     &kp E   &kp R   &kp T   &kp Y     &kp U    &kp I      &kp O     &kp P      &kp BSLH
&kp CAPS   &kp A      &kp S     &kp D   &kp F   &kp G   &kp H     &kp J    &kp K      &kp L     &kp SEMI   &kp ENTER
&kp LSHFT  &kp Z      &kp X     &kp C   &kp V   &kp B   &kp N     &kp M    &kp COMMA  &kp DOT   &kp FSLH   &kp RIGHT_SHIFT
&kp LCTRL  &kp LALT   &kp LGUI  &none   &none   &none   &none     &none    &none      &kp LANG1 &kp RCTRL  &kp INSERT
&kp BACKSPACE &kp SPACE  &mo 1                          &mo 1     &kp SPACE  &kp BACKSPACE &kp B
            >;
        };

        lower_layer {
            bindings = <
&kp F1      &kp F2        &kp F3        &kp F4        &kp F5  &kp F6  &kp F7     &kp F8         &kp F9     &kp F10    &kp F11   &kp F12
&kp GRAVE   &kp HOME      &kp UP        &kp END       &kp PG_UP   &kp LC(INS) &mkp MCLK  &kp GRAVE      &kp MINUS  &kp EQUAL  &trans    &trans
&trans      &kp LEFT      &kp DOWN      &kp RIGHT     &kp PG_DN   &kp LS(INS) &mkp RCLK  &kp LG(LS(S))  &kp LBKT   &kp RBKT   &kp SQT   &kp ENTER
&kp LSHFT   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans  &to 7   &mkp LCLK  &kp PSCRN      &trans     &trans     &kp BSLH  &kp RIGHT_SHIFT
&mo 2       &to 0         &to 3         &trans        &trans  &trans  &trans     &trans         &trans     &trans     &kp INS   &kp DEL
&trans      &trans        &trans                                      &kp ENTER  &kp BACKSPACE  &trans     &trans
            >;
        };

        layer_2 {
            // Hold layer 1, then the left Ctrl position (&mo 2).
            // R: Studio unlock; T: USB output. Existing 5/6 bootloader keys remain.
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR  &bootloader  &bootloader  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &studio_unlock  &out OUT_USB  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans       &trans       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans       &trans       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans       &trans       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans                               &trans       &trans  &trans  &trans
            >;
        };

        mac_layer {
            // -----------------------------------------------------------------
            // Left modifiers for Mac:
            // | CTRL | OPT(ALT) | CMD(GUI) | ... | SPACE |

            bindings = <
&kp ESC    &kp N1     &kp N2    &kp N3  &kp N4  &kp N5  &kp N6    &kp N7   &kp N8     &kp N9    &kp N0     &kp DELETE
&kp TAB    &kp Q      &kp W     &kp E   &kp R   &kp T   &kp Y     &kp U    &kp I      &kp O     &kp P      &kp BSLH
&kp CAPS   &kp A      &kp S     &kp D   &kp F   &kp G   &kp H     &kp J    &kp K      &kp L     &kp SEMI   &kp ENTER
&kp LSHFT  &kp Z      &kp X     &kp C   &kp V   &kp B   &kp N     &kp M    &kp COMMA  &kp DOT   &kp FSLH   &kp RIGHT_SHIFT
&kp LCTRL  &kp LALT   &kp LGUI  &none   &none   &none   &none     &none    &none      &kp RGUI  &kp RCTRL  &kp INSERT
&kp LANG1  &kp SPACE  &mo 4                             &mo 4     &kp SPACE  &kp BACKSPACE &kp B
            >;
        };

        mac_lower_layer {
            bindings = <
&kp F1      &kp F2        &kp F3        &kp F4        &kp F5  &kp F6  &kp F7     &kp F8         &kp F9     &kp F10    &kp F11   &kp F12
&kp GRAVE   &kp HOME      &kp UP        &kp END       &kp PG_UP &kp LG(C) &mkp MCLK  &kp GRAVE      &kp MINUS  &kp EQUAL  &trans    &trans
&trans      &kp LEFT      &kp DOWN      &kp RIGHT     &kp PG_DN &kp LG(V) &mkp RCLK  &kp LG(LS(N4)) &kp LBKT   &kp RBKT   &kp SQT   &kp ENTER
&kp LSHFT   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans  &to 5   &mkp LCLK  &kp PSCRN      &trans     &trans     &kp BSLH  &kp RIGHT_SHIFT
&mo 2       &to 0         &to 3         &trans        &trans  &trans  &trans     &trans         &trans     &trans     &kp INS   &kp DEL
&trans      &trans        &trans                                      &kp ENTER  &kp BACKSPACE  &trans     &trans
            >;
        };

        mac_media_layer {
            // -----------------------------------------------------------------
            // Mac layer with Media keys enabled on Lower (mo 6)

            bindings = <
&kp ESC    &kp N1     &kp N2    &kp N3  &kp N4  &kp N5  &kp N6    &kp N7   &kp N8     &kp N9    &kp N0     &kp DELETE
&kp TAB    &kp Q      &kp W     &kp E   &kp R   &kp T   &kp Y     &kp U    &kp I      &kp O     &kp P      &kp BSLH
&kp CAPS   &kp A      &kp S     &kp D   &kp F   &kp G   &kp H     &kp J    &kp K      &kp L     &kp SEMI   &kp ENTER
&kp LSHFT  &kp Z      &kp X     &kp C   &kp V   &kp B   &kp N     &kp M    &kp COMMA  &kp DOT   &kp FSLH   &kp RIGHT_SHIFT
&kp LCTRL  &kp LALT   &kp LGUI  &none   &none   &none   &none     &none    &none      &kp RGUI  &kp RCTRL  &kp INSERT
&kp LANG1  &kp SPACE  &mo 6                             &mo 6     &kp SPACE  &kp BACKSPACE &kp B
            >;
        };

        mac_media_lower_layer {
            bindings = <
&kp C_BRI_DN  &kp C_BRI_UP  &kp F3        &kp C_AC_SEARCH  &kp C_VOICE_COMMAND  &kp F6  &kp C_PREV  &kp C_PP       &kp C_NEXT  &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP
&kp GRAVE     &kp HOME      &kp UP        &kp END          &kp PG_UP            &kp LG(C)  &mkp MCLK   &kp GRAVE      &kp MINUS   &kp EQUAL   &trans        &trans
&trans        &kp LEFT      &kp DOWN      &kp RIGHT        &kp PG_DN            &kp LG(V)  &mkp RCLK   &kp LG(LS(N4)) &kp LBKT    &kp RBKT    &kp SQT       &kp ENTER
&kp LSHFT     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2     &trans               &to 3   &mkp LCLK   &kp PSCRN      &trans      &trans      &kp BSLH      &kp RIGHT_SHIFT
&mo 2         &to 0         &to 3         &trans           &trans               &trans  &trans      &trans         &trans      &trans      &kp INS       &kp DEL
&trans        &trans        &trans                                                      &kp ENTER   &kp BACKSPACE  &trans      &trans
            >;
        };

        win_media_layer {
            // -----------------------------------------------------------------
            // Windows layer with Media keys enabled on Lower (mo 8)

            bindings = <
&kp ESC    &kp N1     &kp N2    &kp N3  &kp N4  &kp N5  &kp N6    &kp N7   &kp N8     &kp N9    &kp N0     &kp DELETE
&kp TAB    &kp Q      &kp W     &kp E   &kp R   &kp T   &kp Y     &kp U    &kp I      &kp O     &kp P      &kp BSLH
&kp CAPS   &kp A      &kp S     &kp D   &kp F   &kp G   &kp H     &kp J    &kp K      &kp L     &kp SEMI   &kp ENTER
&kp LSHFT  &kp Z      &kp X     &kp C   &kp V   &kp B   &kp N     &kp M    &kp COMMA  &kp DOT   &kp FSLH   &kp RIGHT_SHIFT
&kp LCTRL  &kp LALT   &kp LGUI  &none   &none   &none   &none     &none    &none      &kp LANG1 &kp RCTRL  &kp INSERT
&kp BACKSPACE &kp SPACE  &mo 8                          &mo 8     &kp SPACE  &kp BACKSPACE &kp B
            >;
        };

        win_media_lower_layer {
            bindings = <
&kp C_BRI_DN  &kp C_BRI_UP  &kp F3        &kp C_AC_SEARCH  &kp C_VOICE_COMMAND  &kp F6  &kp C_PREV  &kp C_PP       &kp C_NEXT  &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP
&kp GRAVE     &kp HOME      &kp UP        &kp END          &kp PG_UP            &kp LC(INS)    &mkp MCLK   &kp GRAVE      &kp MINUS   &kp EQUAL   &trans        &trans
&trans        &kp LEFT      &kp DOWN      &kp RIGHT        &kp PG_DN            &kp LS(INS)    &mkp RCLK   &kp LG(LS(S))  &kp LBKT    &kp RBKT    &kp SQT       &kp ENTER
&kp LSHFT     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2     &trans               &to 0   &mkp LCLK   &kp PSCRN      &trans      &trans      &kp BSLH      &kp RIGHT_SHIFT
&mo 2         &to 0         &to 3         &trans           &trans               &trans  &trans      &trans         &trans      &trans      &kp INS       &kp DEL
&trans        &trans        &trans                                                      &kp ENTER   &kp BACKSPACE  &trans      &trans
            >;
        };
    };
};
