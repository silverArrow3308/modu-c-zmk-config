 *
 * Optimized:
 * Reduced 9 layers to 6 using Conditional Layers.
 * - Left MO: Navigation & F-keys (Win Lower / Mac Lower)
 * - Right MO: Media Controls (Raise)
 * - Both MOs: Adjust (Bootloader, BT, OS Toggle)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>
#include "modu-layouts.dtsi"

/ {
    /*
     * -------------------------------------------------------------------------
     * [레이어 구조 안내]
     * - Layer 0 (default_layer) : Windows 기본
     * - Layer 1 (lower_layer)   : Windows Lower (F1~F12, 방향키, Win 클립보드)
     * - Layer 2 (mac_layer)     : Mac 기본
     * - Layer 3 (mac_lower_layer): Mac Lower (F1~F12, 방향키, Mac 클립보드)
     * - Layer 4 (raise_media)   : 미디어 컨트롤 (밝기, 볼륨, 트랙 제어)
     * - Layer 5 (adjust_system) : 시스템 설정 (양손 엄지 동시 홀드 시 발동)
     *
     * [시스템 리셋 콤보]
     * - Lower 또는 Adjust 상태에서 LCTRL(48) + 5 + 6 동시 입력
     * -------------------------------------------------------------------------
     */

    combos {
        compatible = "zmk,combos";

        reset {
            bindings = <&sys_reset>;
            key-positions = <48 5 6>;
            layers = <1 3 5>; // Lower 및 Adjust 상태에서만 작동하여 일상 타이핑 오작동 방지
        };
    };

    // 양손 엄지 MO를 동시에 누르면 ADJUST(시스템/부트로더) 레이어 자동 활성화
    conditional_layers {
        compatible = "zmk,conditional-layers";
        
        adjust_win {
            if-layers = <1 4>; // Win Lower(1) + Raise(4) 동시 입력 시
            then-layer = <5>;  // Adjust(5) 활성화
        };
        adjust_mac {
            if-layers = <3 4>; // Mac Lower(3) + Raise(4) 동시 입력 시
            then-layer = <5>;  // Adjust(5) 활성화
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Layer 0: 윈도우 기본
        default_layer {
            bindings = <
&kp ESC       &kp N1     &kp N2    &kp N3  &kp N4  &kp N5  &kp N6    &kp N7     &kp N8     &kp N9    &kp N0     &kp DELETE
&kp TAB       &kp Q      &kp W     &kp E   &kp R   &kp T   &kp Y     &kp U      &kp I      &kp O     &kp P      &kp BSLH
&kp CAPS      &kp A      &kp S     &kp D   &kp F   &kp G   &kp H     &kp J      &kp K      &kp L     &kp SEMI   &kp ENTER
&kp LSHFT     &kp Z      &kp X     &kp C   &kp V   &kp B   &kp N     &kp M      &kp COMMA  &kp DOT   &kp FSLH   &kp RIGHT_SHIFT
&kp LCTRL     &kp LALT   &kp LGUI  &none   &none   &none   &none     &none      &none      &kp LANG1 &kp RCTRL  &kp INSERT
&kp BACKSPACE &kp SPACE  &mo 1                             &mo 4     &kp SPACE  &kp BACKSPACE &kp B
            >;
        };

        // Layer 1: 윈도우 네비게이션 & F키 (왼쪽 엄지)
        lower_layer {
            bindings = <
&kp F1      &kp F2        &kp F3        &kp F4        &kp F5    &kp F6        &kp F7     &kp F8         &kp F9     &kp F10    &kp F11   &kp F12
&kp GRAVE   &kp HOME      &kp UP        &kp END       &kp PG_UP &kp LC(INS)   &mkp MCLK  &kp GRAVE      &kp MINUS  &kp EQUAL  &trans    &trans
&trans      &kp LEFT      &kp DOWN      &kp RIGHT     &kp PG_DN &kp LS(INS)   &mkp RCLK  &kp LG(LS(S))  &kp LBKT   &kp RBKT   &kp SQT   &kp ENTER
&kp LSHFT   &trans        &trans        &trans        &trans    &trans        &mkp LCLK  &kp PSCRN      &trans     &trans     &kp BSLH  &kp RIGHT_SHIFT
&trans      &trans        &trans        &trans        &trans    &trans        &trans     &trans         &trans     &trans     &kp INS   &kp DEL
&trans      &trans        &trans                                              &trans     &kp ENTER      &kp BACKSPACE &trans
            >;
        };

        // Layer 2: 맥 기본
        mac_layer {
            bindings = <
&kp ESC       &kp N1     &kp N2    &kp N3  &kp N4  &kp N5  &kp N6    &kp N7     &kp N8     &kp N9    &kp N0     &kp DELETE
&kp TAB       &kp Q      &kp W     &kp E   &kp R   &kp T   &kp Y     &kp U      &kp I      &kp O     &kp P      &kp BSLH
&kp CAPS      &kp A      &kp S     &kp D   &kp F   &kp G   &kp H     &kp J      &kp K      &kp L     &kp SEMI   &kp ENTER
&kp LSHFT     &kp Z      &kp X     &kp C   &kp V   &kp B   &kp N     &kp M      &kp COMMA  &kp DOT   &kp FSLH   &kp RIGHT_SHIFT
&kp LCTRL     &kp LALT   &kp LGUI  &none   &none   &none   &none     &none      &none      &kp RGUI  &kp RCTRL  &kp INSERT
&kp LANG1     &kp SPACE  &mo 3                             &mo 4     &kp SPACE  &kp BACKSPACE &kp B
            >;
        };

        // Layer 3: 맥 네비게이션 & F키 (왼쪽 엄지) - 맥 전용 복붙(Cmd+C)
        mac_lower_layer {
            bindings = <
&kp F1      &kp F2        &kp F3        &kp F4        &kp F5    &kp F6        &kp F7     &kp F8         &kp F9     &kp F10    &kp F11   &kp F12
&kp GRAVE   &kp HOME      &kp UP        &kp END       &kp PG_UP &kp LG(C)     &mkp MCLK  &kp GRAVE      &kp MINUS  &kp EQUAL  &trans    &trans
&trans      &kp LEFT      &kp DOWN      &kp RIGHT     &kp PG_DN &kp LG(V)     &mkp RCLK  &kp LG(LS(N4)) &kp LBKT   &kp RBKT   &kp SQT   &kp ENTER
&kp LSHFT   &trans        &trans        &trans        &trans    &trans        &mkp LCLK  &kp PSCRN      &trans     &trans     &kp BSLH  &kp RIGHT_SHIFT
&trans      &trans        &trans        &trans        &trans    &trans        &trans     &trans         &trans     &trans     &kp INS   &kp DEL
&trans      &trans        &trans                                              &trans     &kp ENTER      &kp BACKSPACE &trans
            >;
        };

        // Layer 4: 미디어 컨트롤 전용 (오른쪽 엄지) - Win/Mac 공용
        raise_media {
            bindings = <
&kp C_BRI_DN  &kp C_BRI_UP  &kp F3        &kp C_AC_SEARCH &kp C_VOICE_COMMAND &kp F6    &kp C_PREV  &kp C_PP       &kp C_NEXT  &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP
&trans        &trans        &trans        &trans          &trans              &trans    &trans      &trans         &trans      &trans      &trans        &trans
&trans        &trans        &trans        &trans          &trans              &trans    &trans      &trans         &trans      &trans      &trans        &trans
&trans        &trans        &trans        &trans          &trans              &trans    &trans      &trans         &trans      &trans      &trans        &trans
&trans        &trans        &trans        &trans          &trans              &trans    &trans      &trans         &trans      &trans      &trans        &trans
&trans        &trans        &trans                                                      &trans      &trans         &trans      &trans
            >;
        };

        // Layer 5: 시스템/부트로더 설정 (양쪽 엄지 동시 누름)
        adjust_system {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR      &bootloader  &bootloader  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &studio_unlock  &out OUT_USB &trans       &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans          &trans       &trans       &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans          &trans       &trans       &trans  &trans  &trans  &trans  &trans
&trans  &to 0         &to 2         &trans        &trans          &trans       &trans       &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans                                                   &trans       &trans  &trans  &trans
            >;
        };
    };
};